# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://blackboxr.example

# --- The box ------------------------------------------------------------
# Leave the address unset until the contract is deployed. With it unset the
# counter reads zero behind an "awaiting launch" tag, the ledger is empty, and
# the only figures that move are the ones a visitor starts themselves with the
# in-page simulation.
NEXT_PUBLIC_BLACKBOXR_CONTRACT_ADDRESS=
# Needs to be true AND a contract address before anything reads as live.
NEXT_PUBLIC_BLACKBOXR_LIVE=false

# Fee taken on every trade, in basis points. 200 = 2%. This number is quoted
# on the page, so it must match what the contract actually charges.
NEXT_PUBLIC_BLACKBOXR_FEE_BPS=200

# --- Chain --------------------------------------------------------------
# Defaults to Base (8453). Set all three together if you move it.
NEXT_PUBLIC_BLACKBOXR_CHAIN_ID=
NEXT_PUBLIC_BLACKBOXR_CHAIN_NAME=
NEXT_PUBLIC_BLACKBOXR_RPC_URL=

# --- Socials ------------------------------------------------------------
# X defaults to https://x.com/Blackboxr_xyz in site-config.ts; set this only to
# override it. Telegram is hidden from the nav and footer while unset.
NEXT_PUBLIC_BLACKBOXR_X=
NEXT_PUBLIC_BLACKBOXR_TELEGRAM=
